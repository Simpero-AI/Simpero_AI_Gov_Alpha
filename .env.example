# Runtime DB connection — dd_app role, routed through PgBouncer
# Format: postgresql+asyncpg://dd_app:<password>@<pgbouncer-host>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://username-changeme:CHANGEME@pgbouncer:5432/simpero

# Migration DB connection — dd_owner role, direct to DigitalOcean cluster (bypasses PgBouncer)
# NEVER use this URL in runtime application code — DDL privileges only
ALEMBIC_DATABASE_URL=postgresql+psycopg2://username-changeme@<do-cluster-host>:25060/simpero?sslmode=require

# Public intake DB connection — dd_public role, the RLS-keyhole-restricted role
# for the unauthenticated External Deal Intake Link surface, routed through
# PgBouncer's dedicated simpero_public entry (see docker/pgbouncer.ini)
# Format: postgresql+asyncpg://dd_public:<password>@<pgbouncer-host>:5432/simpero_public
PUBLIC_DATABASE_URL=postgresql+asyncpg://username-changeme:CHANGEME@pgbouncer:5432/simpero_public

# Signing secret for the self-issued intake-session JWT (own key/audience --
# not Clerk's). HS256, symmetric: this app both issues and verifies it.
INTAKE_SESSION_JWT_SECRET=CHANGEME

# Clerk authentication
# Get from: Clerk Dashboard > API Keys
CLERK_SECRET_KEY=sk_test_CHANGEME
# Clerk JWKS endpoint — format: https://<your-clerk-frontend-api>/.well-known/jwks.json
# TODO: Replace with your actual Clerk frontend API URL from the Clerk dashboard
CLERK_JWKS_URL=https://CHANGEME.clerk.accounts.dev/.well-known/jwks.json

# Job queue — DigitalOcean Managed Valkey (SAQ)
# Get from: DO Dashboard > Databases > your Valkey cluster > Connection Details
# rediss:// (TLS) is required — DO Valkey rejects unencrypted connections from outside its
# private network. ssl_cert_reqs=none matches the sslmode=require (encrypt, don't pin CA)
# posture already used for DATABASE_URL/ALEMBIC_DATABASE_URL above.
VALKEY_URL=rediss://default:CHANGEME@<do-valkey-host>:25061?ssl_cert_reqs=none

# App config
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin portal (app/api/admin)
# Clerk org id of the Simpero-internal platform org. Leave unset/empty in any
# env where the platform-admin surface (POST/GET /api/admin/organizations,
# POST /api/admin/organizations/{id}/invitations) should stay disabled — it
# fails closed (403 for everyone) when empty. Grant a real human `org:admin`
# in this Clerk org once per env to bootstrap the first platform admin (JIT
# provisioned on their first admin request — no migration seed).
SIMPERO_PLATFORM_ORG_ID=CHANGEME
# Deployed frontend base URL. Builds both Clerk invitation redirect targets:
# <APP_BASE_URL>/admin/sign-up (client-admin seed invite) and
# <APP_BASE_URL>/sign-up (product-user invite). /admin/sign-up must exist as
# a route in Simpero_AI_Gov_Web (frontend team owns it) before the admin
# organization-seed flow is usable end-to-end.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# DigitalOcean Spaces (S3-compatible) — same bucket/credentials used for two
# purposes: originally the parser service's Docling document cache (that
# service now lives in Simpero_Gov_AI_Services, not this repo), and, as of
# app/api/uploads, this app's own presigned-PUT document uploads. This app's
# Settings (app/core/config.py) reads these PARSER_SPACES_* vars directly
# (aliased) rather than duplicating them under a second SPACES_* name — one
# bucket, one set of credentials, decided by Vansh. The key + secret are a
# Spaces access key, distinct from your DO API token: DO console > API >
# Spaces Keys > Generate New Key (scope it to the bucket, read+write). The
# secret is shown once — paste it straight into .env, never into chat.
PARSER_SPACES_BUCKET=simpero-cim-xlsx-upload
PARSER_SPACES_REGION=tor1
PARSER_SPACES_ENDPOINT_URL=https://tor1.digitaloceanspaces.com
PARSER_SPACES_ACCESS_KEY_ID=CHANGEME
PARSER_SPACES_SECRET_ACCESS_KEY=CHANGEME
# Optional; defaults to parser/document-cache. Namespaces the parser's own
# cache inside the bucket so it never collides with other objects (e.g.
# app/api/uploads' presigned-upload objects, which use their own key shape —
# see app/services/uploads/spaces.py:build_object_key).
PARSER_SPACES_KEY_PREFIX=parser/document-cache

# SEC EDGAR entity resolution (SIM-262). Keyless — SEC asks only that you
# identify yourself with a descriptive User-Agent naming a real contact, and
# answers 403 to traffic that doesn't. Format is free-form; company plus an
# address you actually monitor is what they ask for. Rate limit is ~10 req/s.
# Leave unset and entity resolution fails closed (EdgarResolver raises at
# construction) rather than sending anonymous traffic that would 403 anyway —
# same posture as VOYAGE_API_KEY.
SEC_EDGAR_USER_AGENT=Simpero AI ops@simpero.ai
